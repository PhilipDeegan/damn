# clang-tidy for damn (mkn's clang.tidy module, profile tidy): checks that find bugs or
# performance problems, not style (as PHARE's), and unused parameters (parameter sets that want a
# DAO). damn's own headers and tests only.
# bugprone-casting-through-void: off, MPI's own constants (MPI_COMM_WORLD, MPI_DOUBLE ...) are
#  casts through void *
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  performance-*,
  -bugprone-casting-through-void,
  -performance-avoid-endl,
  misc-unused-parameters,
  clang-diagnostic-unused-parameter,
  clang-diagnostic-unused-variable,
  modernize-use-nodiscard
CheckOptions:
  # damn spells [[nodiscard]] through its NO_DISCARD macro (damn/core/def.hpp)
  modernize-use-nodiscard.ReplacementString: NO_DISCARD
HeaderFilterRegex: '.*/(inc|tst)/damn/.*'
# the compiler's unused warnings (misc-unused-parameters does not look into templates); before
#  the command: a header's command is inferred from a source's, where after it they read as files
ExtraArgsBefore: [-Wunused-parameter, -Wunused-variable]
WarningsAsErrors: ''
