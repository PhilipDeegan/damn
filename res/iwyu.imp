[
  # prefer the C++ headers: <cassert> over <assert.h>. iwyu's own mappings already mark the C
  # headers public, so they can't be remapped by include, only by symbol
  { symbol: ["assert", "private", "<cassert>", "public"] },

  # libstdc++ 14 <format> forward declares std::vector, iwyu credits it when only a declaration
  # is needed
  { symbol: ["std::vector", "private", "<vector>", "public"] },

  # phlop's scope timers come through damn/core/logger.hpp's DAMN_LOG_SCOPE
  { include: ["@\"phlop/timing/.*\"", "private", "\"damn/core/logger.hpp\"", "public"] },

  # MPI comes through damn_mpi.hpp, which silences mpi.h's warnings
  { include: ["\"mpi.h\"", "private", "\"damn/mpi/damn_mpi.hpp\"", "public"] },
  { include: ["<mpi.h>", "private", "\"damn/mpi/damn_mpi.hpp\"", "public"] },

  # HighFive: H5File.hpp (and H5Easy.hpp) are the public headers, its other headers and the HDF5
  # C headers come with them
  { include: ["@\"highfive/bits/.*\"", "private", "\"highfive/H5File.hpp\"", "public"] },
  { include: ["@\"highfive/h5easy_bits/.*\"", "private", "\"highfive/H5Easy.hpp\"", "public"] },
  { include: ["@\"highfive/H5(DataSet|DataSpace|DataType|Group|Object|PropertyList|Attribute|Exception|Selection|Utility)\\.hpp\"", "private", "\"highfive/H5File.hpp\"", "public"] },
  { include: ["@\"H5[A-Za-z_]*\\.hpp\"", "private", "\"highfive/H5File.hpp\"", "public"] },
  { include: ["@\"H5[A-Za-z]*(public|pubconf)\\.h\"", "private", "\"highfive/H5File.hpp\"", "public"] },
  { include: ["@<H5[A-Za-z]*(public|pubconf)\\.h>", "private", "\"highfive/H5File.hpp\"", "public"] },
]
